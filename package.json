{
  "name": "climate-sleep-curve-card",
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "build": "esbuild src/card.mjs --bundle --format=esm --target=es2022 --outfile=climate-sleep-curve-card.js",
    "test": "node --test test/*.test.mjs",
